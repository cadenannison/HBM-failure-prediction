# EXAMPLE ONLY. Copy to terraform.tfvars, replace every example value, and review
# a saved plan before apply. Teammate users are created in the hosting account.
host_account_id  = "278634873542"
region           = "us-east-1"
data_bucket_name = "panic-data-278634873542"

teammate_user_names = {
  lead_ml = "panic-rj"
  mlops   = "panic-caden"
  app     = "panic-joe"
}

# Add only after platform Terraform creates APIs, service roles, and attaches
# their approved permission boundaries. The stack verifies actual role state.
api_gateway_api_ids = []
execution_roles     = {}

# Fill from platform Terraform when Studio is provisioned (IAM-auth mode).
studio_workspaces = {}
